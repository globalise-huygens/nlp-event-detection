ceo:Paying skos:closeMatch fn:CommercialTransaction .
ceo:FinancialTransaction skos:closeMatch fn:CommercialTransaction .
ceo:Paying skos:closeMatch fn:CommercialTransaction .
ceo:Buying skos:closeMatch fn:Commerce_buy .
ceo:Selling skos:closeMatch fn:Commerce_sell .
